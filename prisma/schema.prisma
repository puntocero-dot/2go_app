generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  nombre              String
  telefono            String?
  rol                 RolUsuario
  activo              Boolean              @default(true)
  fotoPerfil          String?
  estadoLoggeo        EstadoLoggeo         @default(OFFLINE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  armador             Armador?
  registrosEstado     RegistroEstado[]
  supervisorProyectos SupervisorProyecto[]
  notificacionesSistemaEnviadas NotificacionSistema[] @relation("NotificacionesSistemaEnviadas")
  notificaciones      NotificacionUsuario[] @relation("NotificacionesUsuario")

  @@index([email])
  @@map("usuarios")
}

model Armador {
  id                     String        @id @default(uuid())
  usuarioId              String        @unique
  estado                 EstadoArmador @default(ACTIVO)
  fechaContratacion      DateTime      @default(now())
  preferenciasHorarias   Json?
  habilidades            String[]
  ubicacionActualLat     Float?
  ubicacionActualLng     Float?
  ultimaActualizacionGPS DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  usuario                Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ordenes                Orden[]
  turnos                 Turno[]

  @@index([estado])
  @@map("armadores")
}

model Proyecto {
  id               String               @id @default(uuid())
  nombreComercial  String
  activo           Boolean              @default(true)
  tipoCliente      TipoCliente
  datosFacturacion Json
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  muebles          Mueble[]
  ordenes          Orden[]
  reglaCobro       ReglaCobro?
  supervisores     SupervisorProyecto[]
  usuariosFinales  UsuarioFinal[]

  @@index([activo])
  @@map("proyectos")
}

model SupervisorProyecto {
  id         String   @id @default(uuid())
  usuarioId  String
  proyectoId String
  createdAt  DateTime @default(now())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, proyectoId])
  @@index([proyectoId])
  @@map("supervisor_proyectos")
}

model ReglaCobro {
  id                 String             @id @default(uuid())
  proyectoId         String             @unique
  tipoPrincipal      TipoReglaPrincipal
  precioFijoUnitario Float?
  precioVIP          Float              @default(0)
  precioUrgente      Float              @default(0)
  precioMedia        Float              @default(0)
  precioNormal       Float              @default(0)
  precioGrande       Float              @default(0)
  precioMediano      Float              @default(0)
  precioPequeno      Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  cobrosDistancia    CobroDistancia[]
  penalizaciones     Penalizacion[]
  rangosVolumen      RangoVolumen[]
  proyecto           Proyecto           @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("reglas_cobro")
}

model RangoVolumen {
  id           String     @id @default(uuid())
  reglaCobroId String
  desde        Int
  hasta        Int?
  precio       Float
  createdAt    DateTime   @default(now())
  reglaCobro   ReglaCobro @relation(fields: [reglaCobroId], references: [id], onDelete: Cascade)

  @@index([reglaCobroId])
  @@map("rangos_volumen")
}

model CobroDistancia {
  id           String     @id @default(uuid())
  reglaCobroId String
  municipio    String
  precio       Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reglaCobro   ReglaCobro @relation(fields: [reglaCobroId], references: [id], onDelete: Cascade)

  @@unique([reglaCobroId, municipio])
  @@index([reglaCobroId])
  @@map("cobros_distancia")
}

model Penalizacion {
  id           String           @id @default(uuid())
  reglaCobroId String
  tipo         TipoPenalizacion
  precio       Float
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  reglaCobro   ReglaCobro       @relation(fields: [reglaCobroId], references: [id], onDelete: Cascade)

  @@unique([reglaCobroId, tipo])
  @@index([reglaCobroId])
  @@map("penalizaciones")
}

model Mueble {
  id          String       @id @default(uuid())
  nombre      String
  tamano      TamanoMueble
  descripcion String?
  proyectoId  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  proyecto    Proyecto     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  ordenes     Orden[]

  @@index([proyectoId])
  @@map("muebles")
}

model UsuarioFinal {
  id                String           @id @default(uuid())
  nombre            String
  telefono          String
  email             String?
  direccionCompleta String
  municipio         String
  departamento      String
  coordenadasLat    Float?
  coordenadasLng    Float?
  prioridad         PrioridadUsuario @default(NORMAL)
  proyectoId        String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ordenes           Orden[]
  proyecto          Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  notificaciones    Notificacion[]

  @@index([proyectoId])
  @@index([municipio])
  @@map("usuarios_finales")
}

model Orden {
  id                      String                 @id @default(uuid())
  codigoReferenciaRetail  String
  muebleId                String
  usuarioFinalId          String
  armadorId               String?
  proyectoId              String
  fechaCreacion           DateTime               @default(now())
  fechaSolicitadaCliente  DateTime?
  fechaAsignacion         DateTime?
  fechaRuta               DateTime?
  fechaInicioArmado       DateTime?
  fechaFinArmado          DateTime?
  fechaCompletado         DateTime?
  estado                  EstadoOrden            @default(SIN_ASIGNAR)
  tiempoAcumuladoEstados  Json?
  cobroFinal              Float?
  desgloseCobro           Json?
  linkMagicoToken         String                 @unique @default(uuid())
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  prioridad               PrioridadUsuario       @default(NORMAL)
  documentoReceptor       String?
  nombreReceptor          String?
  csatComentario          String?
  csatFecha               DateTime?
  csatPuntaje             Int?
  archivos                ArchivoOrden[]
  notificaciones          Notificacion[]
  armador                 Armador?               @relation(fields: [armadorId], references: [id])
  mueble                  Mueble                 @relation(fields: [muebleId], references: [id])
  proyecto                Proyecto               @relation(fields: [proyectoId], references: [id])
  usuarioFinal            UsuarioFinal           @relation(fields: [usuarioFinalId], references: [id])
  penalizacionesAplicadas PenalizacionAplicada[]
  registrosEstado         RegistroEstado[]

  @@index([estado])
  @@index([proyectoId])
  @@index([armadorId])
  @@index([linkMagicoToken])
  @@map("ordenes")
}

model RegistroEstado {
  id              String       @id @default(uuid())
  ordenId         String
  estadoAnterior  EstadoOrden?
  estadoNuevo     EstadoOrden?
  estadoCambiadoA EstadoOrden
  comentario      String?
  usuarioId       String?
  timestamp       DateTime     @default(now())
  latitud         Float?
  longitud        Float?
  etaEstimado     DateTime?
  orden           Orden        @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  usuario         Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([ordenId])
  @@index([timestamp])
  @@map("registros_estado")
}

model ArchivoOrden {
  id                         String      @id @default(uuid())
  ordenId                    String
  url                        String
  tipo                       TipoArchivo
  fechaSubida                DateTime    @default(now())
  fechaEliminacionProgramada DateTime
  orden                      Orden       @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@index([fechaEliminacionProgramada])
  @@map("archivos_ordenes")
}

model PenalizacionAplicada {
  id             String           @id @default(uuid())
  ordenId        String
  tipo           TipoPenalizacion
  monto          Float
  fechaIncidente DateTime         @default(now())
  descripcion    String?
  createdAt      DateTime         @default(now())
  orden          Orden            @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@map("penalizaciones_aplicadas")
}

model ConfiguracionSistema {
  id          String   @id @default(uuid())
  clave       String   @unique
  valor       Json
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("configuracion_sistema")
}

model LogActividad {
  id        String   @id @default(uuid())
  usuarioId String?
  accion    String
  entidad   String?
  entidadId String?
  detalles  Json?
  timestamp DateTime @default(now())

  @@index([usuarioId])
  @@index([timestamp])
  @@map("logs_actividad")
}

enum TamanoMueble {
  GRANDE
  MEDIANO
  PEQUENO
}

enum PrioridadUsuario {
  VIP
  URGENTE
  MEDIA
  NORMAL
}

enum EstadoArmador {
  ACTIVO
  INACTIVO
  VACACIONES
}

enum TipoCliente {
  CREDITO_FISCAL
  CONSUMIDOR_FINAL
}

enum EstadoOrden {
  SIN_ASIGNAR
  ASIGNADO
  EN_RUTA
  ARMADO_INICIADO
  ARMADO_FINALIZADO
  ARMADO_COMPLETADO
  CANCELADA
}

// Modelos de notificaciones
model Notificacion {
  id                String                @id @default(cuid())
  ordenId           String
  tipo              String                // ESTADO_ACTUALIZADO, RECORDATORIO, ALERTA
  mensaje           String
  destinatarioId    String
  enviado           Boolean               @default(false)
  fechaEnvio        DateTime?
  fechaCreacion     DateTime              @default(now())
  orden             Orden                 @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  destinatario      UsuarioFinal          @relation(fields: [destinatarioId], references: [id], onDelete: Cascade)
  
  @@map("notificaciones")
}

model NotificacionSistema {
  id                String                @id @default(cuid())
  titulo            String
  mensaje           String
  accionUrl         String?
  accionTexto       String?
  enviadoPorId      String
  totalEnviados     Int                   @default(0)
  totalErrores      Int                   @default(0)
  fechaEnvio        DateTime              @default(now())
  enviadoPor        Usuario               @relation("NotificacionesSistemaEnviadas", fields: [enviadoPorId], references: [id], onDelete: Cascade)
  
  @@map("notificaciones_sistema")
}

// Notificaciones internas para usuarios del sistema (Admin, Supervisor, Armador)
model NotificacionUsuario {
  id          String   @id @default(cuid())
  usuarioId   String
  tipo        String   // ORDEN_ASIGNADA, ORDEN_TOMADA, ORDEN_COMPLETADA, ALERTA_PARADA, etc.
  titulo      String
  mensaje     String
  datos       Json?    // Datos adicionales (ordenId, armadorId, etc.)
  leida       Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  usuario     Usuario  @relation("NotificacionesUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  
  @@index([usuarioId, leida])
  @@index([createdAt(sort: Desc)])
  @@map("notificaciones_usuario")
}

enum RolUsuario {
  ADMIN
  SUPERVISOR
  ARMADOR
}

enum TipoArchivo {
  FOTO
  VIDEO
}

enum TipoPenalizacion {
  CLIENTE_NO_CONTESTO
  PEDIDO_CANCELADO_EN_RUTA
}

enum TipoReglaPrincipal {
  COBRO_FIJO_UNITARIO
  COBRO_POR_VOLUMEN
}

model ConfiguracionFacturacion {
  id                String   @id @default(uuid())
  nombreEmpresa     String   @default("Armados 2Go")
  giro              String   @default("Servicios de armado de muebles")
  direccion         String   @default("San Salvador, El Salvador")
  telefono          String   @default("+503 0000-0000")
  email             String   @default("facturacion@armados2go.com")
  logoUrl           String?
  colorPrimario     String   @default("#2E4F4F")
  colorAccent       String   @default("#ED7D32")
  terminosCondiciones String?
  notasPiePagina    String   @default("Esta factura es un documento oficial generado por el sistema Armados 2Go.")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("configuracion_facturacion")
}

enum EstadoLoggeo {
  ACTIVO
  LUNCH
  BREAK
  OFFLINE
}

enum EstadoTurno {
  ACTIVO
  PAUSADO
  FINALIZADO
  CANCELADO
}

enum TipoPunto {
  INICIO
  INTERMEDIO
  PARADA
  FIN
}

model Turno {
  id            String      @id @default(uuid())
  armadorId     String
  armador       Armador     @relation(fields: [armadorId], references: [id], onDelete: Cascade)
  inicioTurno   DateTime    @default(now())
  finTurno      DateTime?
  estado        EstadoTurno @default(ACTIVO)
  rutaPuntos    RutaPunto[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([armadorId])
  @@index([estado])
  @@index([inicioTurno])
  @@map("turnos")
}

model RutaPunto {
  id          String    @id @default(uuid())
  turnoId     String
  turno       Turno     @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  latitud     Float
  longitud    Float
  timestamp   DateTime  @default(now())
  tipo        TipoPunto @default(INTERMEDIO)
  descripcion String?
  createdAt   DateTime  @default(now())
  
  @@index([turnoId])
  @@index([timestamp])
  @@map("ruta_puntos")
}

// Modelo de auditoría para trazabilidad de acciones críticas
model AuditLog {
  id         String   @id @default(uuid())
  userId     String   // ID del usuario que realizó la acción
  userName   String   // Nombre del usuario (desnormalizado para histórico)
  userRole   String   // Rol del usuario en el momento de la acción
  action     String   // Acción realizada (CREATE_ORDER, UPDATE_CONFIG, DELETE_USER, etc.)
  resource   String   // Tipo de recurso afectado (orden, turno, usuario, configuracion, etc.)
  resourceId String?  // ID del recurso afectado (si aplica)
  changes    Json?    // Cambios realizados (before/after)
  metadata   Json?    // Metadata adicional (query params, headers relevantes, etc.)
  ip         String?  // IP del cliente
  userAgent  String?  // User agent del cliente
  status     String   @default("SUCCESS") // SUCCESS, FAILED, BLOCKED
  errorMsg   String?  // Mensaje de error si status = FAILED
  createdAt  DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@index([status])
  @@map("audit_logs")
}

model ConfiguracionGeomaps {
  id                        String   @id @default(uuid())
  duracionMinimaParada      Int      @default(5)    // Minutos para considerar una parada
  radioParada               Int      @default(50)   // Metros de radio para detectar parada
  umbralVelocidadExcesiva   Int      @default(80)   // km/h para alertar velocidad excesiva
  radioProximidadCliente    Int      @default(100)  // Metros para considerar que llegó al cliente
  intervaloActualizacionGPS Int      @default(2)    // Minutos entre actualizaciones GPS
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("configuracion_geomaps")
}
