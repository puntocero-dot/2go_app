# Database
# ⚠️ IMPORTANTE: En desarrollo SIEMPRE usa localhost
# NUNCA pongas la URL de producción aquí
DATABASE_URL="postgresql://user:password@localhost:5432/armados2go_dev"

# Para producción, configura en Vercel Environment Variables:
# DATABASE_URL="postgresql://...@supabase.com:5432/postgres"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Cloudinary (para upload de imágenes)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Mapbox (para tracking de rutas)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-token"

# Resend (para emails - opcional)
RESEND_API_KEY="re_your-resend-key"

# Rate Limiting (opcional - defaults en código)
RATE_LIMIT_GPS="120"           # Requests/hora para GPS tracking
RATE_LIMIT_UPLOAD="10"         # Uploads/hora por usuario
RATE_LIMIT_ESTADO="30"         # Cambios de estado/hora
RATE_LIMIT_AUTH="5"            # Intentos de login/hora por IP
RATE_LIMIT_DEFAULT="60"        # Requests/minuto por defecto
RATE_LIMIT_WHITELIST="127.0.0.1,localhost"  # IPs sin límite (separadas por coma)

# Feature Flags (true/false - defaults en código)
NEXT_PUBLIC_FF_TRACKING_AUTO="true"        # Tracking GPS automático
NEXT_PUBLIC_FF_PDF_V2="false"              # Nueva versión de PDFs
NEXT_PUBLIC_FF_RATE_LIMIT_STRICT="true"    # Rate limiting estricto
NEXT_PUBLIC_FF_SMART_SAMPLING="true"       # Smart sampling GPS (>50m)
NEXT_PUBLIC_FF_POLYLINE_ENCODING="false"   # Compresión Polyline de rutas
NEXT_PUBLIC_FF_SERVICE_LAYER="false"       # Nueva capa de servicios
NEXT_PUBLIC_FF_AUDITORIA_DETALLADA="true"  # Logging detallado

# Feature Flags — Fase 1 IA
NEXT_PUBLIC_FF_AI_SMART_ASSIGNMENT="false" # Asignación inteligente con datos históricos
NEXT_PUBLIC_FF_PREDICTIVE_ETA="false"      # ETA corregido por municipio
NEXT_PUBLIC_FF_REALTIME_SSE="false"        # Actualizaciones en tiempo real (SSE)
NEXT_PUBLIC_FF_PUSH_NOTIFICATIONS="false"  # Notificaciones push (Web Push API)

# Tracking GPS
TRACKING_MIN_DISTANCE="50"  # Metros mínimos para guardar punto GPS

# Upstash Redis (requerido para SSE, ETA predictivo y rate limiting distribuido)
# Crear cuenta gratis en https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Web Push / VAPID Keys (generar con: node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())")
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="mailto:admin@tudominio.com"
